GEMINI_API_KEY=your_key_here
# Vision model. Fallback (gemini-flash-lite-latest) is used automatically if this one is overloaded.
GEMINI_MODEL=gemini-3.5-flash

# Required everywhere except `npm run dev` on your own machine. Without it the app is locked
# (503) — on Vercel Production and Preview, and for `npm start`. Use 16+ random characters.
APP_PASSCODE=

# Required wherever APP_PASSCODE is required: the key that signs sign-in sessions (lib/session.ts).
# 32+ random characters, e.g. the output of `openssl rand -base64 48`. Never reuse the passcode.
# Changing it signs out every device (the lost-phone procedure).
SESSION_SECRET=

# Optional (recommended): session store for login rate limiting, daily AI caps and per-device
# sign-out. Set automatically by Vercel's "Upstash for Redis" integration (free tier). Without
# it those three features switch off and everything else works as before.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: photo reads allowed per day (UTC) — per signed-in device, and in total.
# AI_DAILY_LIMIT_PER_SESSION=30
# AI_DAILY_LIMIT_TOTAL=100
