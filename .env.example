GEMINI_API_KEY=your_key_here
# Vision model. Fallback (gemini-flash-lite-latest) is used automatically if this one is overloaded.
GEMINI_MODEL=gemini-3.5-flash

# Required everywhere except `npm run dev` on your own machine. Without it the app is locked
# (503) — on Vercel Production and Preview, and for `npm start`. Use 16+ random characters.
APP_PASSCODE=
