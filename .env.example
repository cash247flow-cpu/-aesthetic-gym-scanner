GEMINI_API_KEY=your_key_here
# Vision model. Fallback (gemini-flash-lite-latest) is used automatically if this one is overloaded.
GEMINI_MODEL=gemini-3.5-flash

# Optional: require a passcode to open the app (set this on Vercel). Leave unset for local dev.
# Use something long, e.g. four random words.
APP_PASSCODE=
